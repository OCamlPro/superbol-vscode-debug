{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Extension",
			"type": "extensionHost",
			"request": "launch",
			"runtimeExecutable": "${execPath}",
			"args": [
				"--profile-temp",
				"--new-window",
				"--transient",
				// "--extensions-dir=${workspaceFolder}/.vscode-test/extensions",
				// "--user-data-dir=${workspaceFolder}/.vscode-test/user-data",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--trace-deprecation",
				"${workspaceFolder}/.vscode-test-workspace",
			],
			"autoAttachChildProcesses": true,
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "npm"
		},
		{
			"name": "Tests",
			"type": "extensionHost",
			"request": "launch",
			"testConfiguration": "${workspaceFolder}/.vscode-test.js",
			"sourceMaps": true,
			"outFiles": [
				"${workspaceFolder}/**/*.(m|c|)js",
				"!**/node_modules/**"
			],
			"preLaunchTask": "npm"
		}
	]
}
