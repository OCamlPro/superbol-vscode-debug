{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm",
			"command": "npm",
			"type": "shell",
			"presentation": {
				"reveal": "silent",
				"revealProblems": "onProblem",
				"panel": "dedicated"
			},
			"args": [
				"run",
				"compile",
				"--loglevel",
				"silent"
			],
			"isBackground": false,
			"problemMatcher": "$tsc-watch",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "package ",
			"command": "vsce",
			"windows": {
				"command": "vsce.cmd"
			},
			"type": "process",
			"presentation": {
				"reveal": "always",
				"panel": "new"
			},
			"args": [
				"package"
			],
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "lint",
			"problemMatcher": ["$eslint-stylish"],
			"label": "npm: lint",
			"detail": "eslint -c .eslintrc.js --ext .ts ./"
		}
	],
}
